APP_NAME=AesthetixAI
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/aesthetixai

# Clerk Auth
CLERK_SECRET_KEY=sk_test_xxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxx
CLERK_JWKS_URL=https://your-clerk.clerk.accounts.dev/.well-known/jwks.json
CLERK_WEBHOOK_SECRET=whsec_xxxx

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud
CLOUDINARY_API_KEY=your_key
CLOUDINARY_API_SECRET=your_secret

# OpenAI / LLM
OPENAI_API_KEY=sk-xxxx
OPENAI_MODEL=gpt-4o

# Mistral (low-stakes tier — see LLMService.chat's `tier` param)
# Optional MISTRAL_API_KEY_2/_3 — extra free-tier accounts' keys, tried in
# order on a 429 before falling back to OpenAI. Free-tier rate limits are
# tight enough to hit during normal dev/testing.
MISTRAL_API_KEY=xxxx
MISTRAL_API_KEY_2=
MISTRAL_API_KEY_3=
MISTRAL_MODEL=mistral-small-latest

# Groq (fallback tier between Mistral and OpenAI — free, fast, generous
# limits; sign up at console.groq.com). See LLMService._call_with_fallback.
GROQ_API_KEY=gsk_xxxx
GROQ_MODEL=gpt-oss-120b

# Twilio
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=xxxx
TWILIO_PHONE_NUMBER=+1xxxx

# WhatsApp Business API (Meta official)
WHATSAPP_API_TOKEN=xxxx
WHATSAPP_PHONE_NUMBER_ID=xxxx

# GREEN-API (green-api.com) — unofficial WhatsApp API for dev/testing
# Per-practice credentials are stored in Practice.settings -> "green_api" key
GREEN_API_INSTANCE_ID=xxxx
GREEN_API_TOKEN=xxxx

# Meta (Instagram/Facebook) OAuth — ONE registered Facebook App for the whole
# platform (developers.facebook.com -> create an App -> Facebook Login for
# Business product -> copy App ID/Secret here). Each practice's Owner then
# connects their own Page/IG account from Settings -> Integrations; nothing
# else needs to change once these are real. Add this app's OAuth redirect URI
# as <your frontend URL>/dashboard/settings/integrations/meta-callback in the
# Facebook App's settings.
META_APP_ID=xxxx
META_APP_SECRET=xxxx

# SendGrid / Email
SENDGRID_API_KEY=SG.xxxx
EMAIL_FROM=noreply@aesthetixai.com

# Resend (used by demo-request confirmation emails — see services/email/resend_service.py)
RESEND_API_KEY=re_xxxx
RESEND_FROM_EMAIL=onboarding@resend.dev

# Stripe
STRIPE_SECRET_KEY=sk_live_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_PRICE_SOLO=price_xxxx
STRIPE_PRICE_PRACTICE=price_xxxx

# Platform admin bootstrap — comma-separated emails. Any Clerk user signing
# in with one of these emails is auto-promoted to platform admin (see
# server/dependencies.py). Further admins are then promoted from /admin itself.
PLATFORM_ADMIN_EMAILS=you@aiaceonesolutions.com

# Standalone admin login (POST /api/v1/admin/auth/login) — username/password + JWT
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_JWT_SECRET=change-me-to-a-long-random-string

# Patient Portal login (portal ID + PIN, separate from Clerk and from ADMIN_JWT_SECRET)
PATIENT_PORTAL_JWT_SECRET=change-me-to-a-long-random-string

#testing email
Doctor login: doctor+clerk_test@aiaceone.dev / password: Aceonedoctor
Staff (Receptionist) login: staff+clerk_test@aiaceone.dev / password: Aceonestaff

# Calendar (Google)
GOOGLE_CLIENT_ID=xxxx
GOOGLE_CLIENT_SECRET=xxxx
GOOGLE_REDIRECT_URI=https://api.aesthetixai.com/v1/integrations/google/callback

# Redis (for Celery)
REDIS_URL=redis://localhost:6379

# Storage
STORAGE_BACKEND=cloudinary
UPLOAD_MAX_SIZE_MB=10
