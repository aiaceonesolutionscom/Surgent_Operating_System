.ruff_cache/
.coverage
htmlcov/
venv/
.venv/
env/
*.egg-info/
*.egg
build/
dist/
.tox/
pip-wheel-metadata/
*.sqlite
*.db

# --- Frontend --------------------------------------------------------------
node_modules/
dist/
dist-ssr/
*.local
.vite/
*.log
