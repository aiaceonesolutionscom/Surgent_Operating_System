# --- AI assistant / agent tooling (local-only) -----------------------------
# Empty tool config dirs left behind locally — never meant to be committed.
.claude/
.aider*
.cursor/
.gemini/
.qodo/

# --- Third-party / scratch assets (local-only) -----------------------------
# Tool used to build the cinematic hero — not part of the product.
lets-scroll-main/
lets-scroll-assets/

# --- PDF extraction artifacts (local-only) -----------------------------------
# Extracted text from PDFs — not source code, safe to delete/re-extract.
*_extracted.txt

# --- Large binaries that shouldn't live in git -----------------------------
# Business decks / pitch PDFs at repo root — keep out of version control.
AIACEONE_Investment.pdf
AIACEONE_Investment_Proposal.pdf
