# Copy this file to .env.local (gitignored) and adjust for your environment.

# Base URL of the backend API (see ../backend). The backend's local dev
# server runs on port 8001, not FastAPI's raw default of 8000 — a mismatch
# here silently falls back to mock data with no visible error, so this
# value matters. Set to the real API domain in production.
VITE_API_BASE_URL=http://127.0.0.1:8001

# Clerk publishable key (safe for the frontend — it's not secret, unlike
# CLERK_SECRET_KEY which stays backend-only). Get it from the Clerk dashboard.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxx

# Sentry frontend DSN (public client key, from Sentry project Client Keys).
# Leave empty to keep browser error tracking disabled.
VITE_SENTRY_DSN=

# PostHog analytics (click tracking + session replay). Leave empty to disable.
# Get key + host from https://us.posthog.com → Project Settings → API key.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
